# Supabase pooler host for the project. Both ports are IPv4.
# :6543 transaction mode  -> app queries, prepare must be false
# :5432 session mode      -> migrations, pg-boss, long-lived processes

# App and worker job handlers. Non-owner role, RLS is enforced against it.
DATABASE_URL="postgresql://rawr_app.PROJECT_REF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_URL_SESSION="postgresql://rawr_app.PROJECT_REF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Table owner. Migrations, tenancy DDL and the pg-boss schema only. Never the app.
DATABASE_URL_OWNER="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Google OAuth, open item 3. INTERNAL consent screen on the datasaur.ai org.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_HOSTED_DOMAIN="datasaur.ai"

# Dev-only sign-in. Refuses to load when NODE_ENV=production.
RAWR_DEV_LOGIN="1"

# Optional. App pool size per process, defaults to 10.
# DATABASE_POOL_MAX="10"

# --- F3 forms, capture and consent -----------------------------------------
# Where the public edge is reachable from datasaur.ai. Defaults to AUTH_URL.
# PUBLIC_BASE_URL="https://rawr.datasaur.ai"

# Rotate by changing this. Visitor IPs are hashed with it and never stored raw.
EDGE_IP_SALT=""

# Cloudflare Turnstile. Challenged only when a submission scores 30..69.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Open item 4. Bot token is the full app; webhook URL is the fallback.
SLACK_BOT_TOKEN=""
SLACK_WEBHOOK_URL=""
SLACK_DEFAULT_CHANNEL="#sales-leads-2026"

# Webflow OAuth app client secret, for verifying native-form webhooks.
WEBFLOW_CLIENT_SECRET=""

# Bump to re-prompt everyone whose stored consent choice predates the change.
CONSENT_POLICY_VERSION="2026-08-24"
