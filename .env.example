# Only what is needed before anybody can sign in, or what decrypts the database.
# Provider credentials are pasted on Settings, Integrations.

DATABASE_URL=""
DATABASE_URL_SESSION=""
DATABASE_URL_OWNER=""

# Creates rawr_app on the next db:migrate, or resets its password. Leave empty
# once the role exists, or DATABASE_URL above stops working.
APP_DB_PASSWORD=""
# 1 only on a direct connection; a transaction pooler drops prepared statements.
DATABASE_PREPARED="0"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Empty: any Google account may sign in, seated by an invitation or by an
# organisation whose own domain matches. Set it to lock sign-in to one domain.
GOOGLE_HOSTED_DOMAIN=""
# 0 asks Google for basic scopes only, so a Workspace that has not reviewed the
# app blocks the calendar rather than sign-in itself.
RAWR_CALENDAR_AT_SIGNIN="1"

RAWR_DEV_LOGIN="1"
RAWR_DEV_CALENDAR="1"
RAWR_DEV_GMAIL="1"
RAWR_DEV_INTEGRATIONS="1"

# 32 bytes from a secrets store, never from the database it protects:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
# Rotate by changing it. Visitor IPs are hashed with it and never stored raw.
EDGE_IP_SALT=""
CONSENT_POLICY_VERSION="2026-08-24"

# The same value on the app and the worker.
RAWR_INTERNAL_SECRET=""
RAWR_INTERNAL_URL="http://localhost:3000"

# Any S3-compatible store. Keep the bucket private: every read is a signed link.
# Supabase: https://PROJECT_REF.supabase.co/storage/v1/s3, with keys from
# Storage, Settings, S3 access keys — not the service_role key.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="attachments"
S3_REGION="us-east-1"

# Optional.
# PUBLIC_BASE_URL=""
# TRUSTED_PROXY_HOPS="1"
# DATABASE_POOL_MAX="20"
# DATABASE_IDLE_TIMEOUT="600"
