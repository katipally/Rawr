# Production. Provider credentials are pasted under Connected apps, never here.

DATABASE_URL=""
# Session mode, never a transaction pooler: pg-boss holds locks across statements.
DATABASE_URL_OWNER=""
# Read by the tenancy suite alone, which wants a second handle as the app role to
# prove one tenant cannot reach another. Not needed on a deployment.
DATABASE_URL_SESSION=""
# 0 through a pooler, 1 on a direct connection.
DATABASE_PREPARED="0"
DATABASE_POOL_MAX="5"
# First migrate on a fresh database only. Clear it after, or the next one resets
# the password DATABASE_URL is using.
APP_DB_PASSWORD=""

# Google is the only way in. Register <AUTH_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_URL=""
PUBLIC_BASE_URL=""

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The server refuses to boot on development values for any of these four.
AUTH_SECRET=""
RAWR_INTERNAL_SECRET=""
EDGE_IP_SALT=""
TOKEN_ENCRYPTION_KEY=""
# Where the worker reaches the web app. Leave it empty when the two run in one
# container: the worker uses http://127.0.0.1:$PORT.
RAWR_INTERNAL_URL=""
# 1 where the verify suites share this database: the worker then leaves the
# fixture tenants (*.test) to them instead of racing their import and bulk runs.
# Unset on a laptop, where those fixtures are the only tenants to test with.
RAWR_WORKER_SKIPS_FIXTURES="1"

# Account slug an otherwise unseated Google account joins, read-only. Empty seats
# nobody, which is what a deployment serving one company wants.
RAWR_VISITOR_ACCOUNT=""
# Set to lock sign-in to one Workspace domain.
GOOGLE_HOSTED_DOMAIN=""
# 1 only once Google has verified the client: the calendar scopes are restricted,
# and an unverified client asking for them can have the whole sign-in refused.
RAWR_CALENDAR_AT_SIGNIN="0"

# Private bucket; every read is a signed link.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="attachments"
S3_REGION="us-east-1"

# Must match the number of proxies actually in front, or per-IP limits are
# spoofable at one end and shared by everybody at the other.
TRUSTED_PROXY_HOPS="1"
# Bumping it re-prompts everyone whose stored consent predates the change.
CONSENT_POLICY_VERSION="2026-08-24"
