# Supabase pooler host for the project. Both ports are IPv4.
# :6543 transaction mode  -> app queries, prepare must be false
# :5432 session mode      -> migrations, pg-boss, long-lived processes

# App and worker job handlers. Non-owner role, RLS is enforced against it.
DATABASE_URL="postgresql://rawr_app.PROJECT_REF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_URL_SESSION="postgresql://rawr_app.PROJECT_REF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Table owner. Migrations, tenancy DDL and the pg-boss schema only. Never the app.
DATABASE_URL_OWNER="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Google OAuth, open item 3. INTERNAL consent screen on the datasaur.ai org.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_HOSTED_DOMAIN="datasaur.ai"

# Dev-only sign-in. Refuses to load when NODE_ENV=production.
RAWR_DEV_LOGIN="1"

# Optional. App pool size per process, defaults to 20.
# DATABASE_POOL_MAX="10"

# --- F3 forms, capture and consent -----------------------------------------
# Where the public edge is reachable from datasaur.ai. Defaults to AUTH_URL.
# PUBLIC_BASE_URL="https://rawr.datasaur.ai"

# Rotate by changing this. Visitor IPs are hashed with it and never stored raw.
EDGE_IP_SALT=""

# How many proxies you run sit in front of the app. The client address is read
# that many entries back from the end of x-forwarded-for, because everything to
# the left of your own hops is whatever the caller chose to send. 1 is a single
# reverse proxy. Too low and the per-IP rate limits are spoofable; too high and
# every visitor shares one bucket.
# TRUSTED_PROXY_HOPS="1"

# Cloudflare Turnstile. Challenged only when a submission scores 30..69.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Open item 4. Bot token is the full app; webhook URL is the fallback.
SLACK_BOT_TOKEN=""
SLACK_WEBHOOK_URL=""
SLACK_DEFAULT_CHANNEL="#sales-leads-2026"

# Webflow OAuth app client secret, for verifying native-form webhooks.
WEBFLOW_CLIENT_SECRET=""

# Bump to re-prompt everyone whose stored consent choice predates the change.
CONSENT_POLICY_VERSION="2026-08-24"

# --- F2 booking ------------------------------------------------------------
# 32 bytes from a secrets store, NOT from this database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Open item 5. Server-to-server OAuth app. Absent, booking uses Google Meet.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Dev only, refused when NODE_ENV=production. Lets a host be bookable with Rawr's
# own confirmed bookings as the only source of busy time, so the engine is
# exercisable while open item 3 is outstanding.
RAWR_DEV_CALENDAR="1"

# --- F4 activity -----------------------------------------------------------
# How long raw page views are kept before they collapse to a daily per-contact
# aggregate. A data-protection decision, not a technical one. Worker only.
ACTIVITY_RETENTION_MONTHS=25

# F1 phase B. A stand-in Gmail so the back-fill, the cursor, participant matching,
# the blocklist and revocation are exercisable before the internal consent screen
# exists (open item 3). Never set in production.
RAWR_DEV_GMAIL=""

# F6. Stand-in providers for Brevo, Apollo, Clay, Slack and GA4, so the framework
# is exercisable before open items 4, 6, 7 and 12 land. Never set in production.
RAWR_DEV_INTEGRATIONS=""

# Shared between the worker and the app so the worker can ask it to run a mailbox
# pass or an integration health check. Set the same value on both.
RAWR_INTERNAL_SECRET=""
RAWR_INTERNAL_URL="http://localhost:3000"

# --- Files on records -------------------------------------------------------
# Supabase Storage, on the project the database already lives in, so there is no
# second vendor and no second credential to rotate. Absent means the Files panel
# on a record says it is not connected rather than half-working.
#
#   1. In Supabase, Storage, create a bucket. Leave it PRIVATE: every read is a
#      signed link that expires, and a public bucket would make that pointless.
#   2. Settings, API: the Project URL goes in SUPABASE_URL, and the service_role
#      key in SUPABASE_SERVICE_ROLE_KEY.
#
# The service key never reaches a browser. What does is a token minted per
# upload and per read, scoped to one path and one operation.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments
