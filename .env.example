# Development. Copy to .env.local and fill in the blanks.
#
# This file is the laptop's configuration and nothing else: everything a
# deployment needs, and the values that must differ there, is in DEPLOY.md.
# Provider credentials -- Brevo, Apollo, Slack, Zoom and the rest -- are pasted
# on each app's own page under Connected apps, never here.


# --- The database -----------------------------------------------------------
# Any Postgres 15+. The app connects as rawr_app, which owns no tables and
# cannot bypass row level security.
DATABASE_URL=""
# The table owner. Migrations use it, and so does pg-boss, which needs a session
# that outlives one statement -- so this one must not be a transaction pooler.
DATABASE_URL_OWNER=""
# Read by the tenancy suite alone (pnpm db:verify), which needs a second handle
# to prove one tenant cannot reach another. Nothing in the app or the worker
# uses it, and a deployment does not need it.
DATABASE_URL_SESSION=""

# Creates rawr_app on the next db:migrate, or resets its password. Leave empty
# once the role exists, or DATABASE_URL above stops working.
APP_DB_PASSWORD=""
# 1 on a direct connection; 0 through a transaction pooler, which drops the
# prepared statements out from under the driver.
DATABASE_PREPARED="1"


# --- Getting in -------------------------------------------------------------
# Google is the only way in. Without these the app runs and nobody can sign in,
# which the sign-in page says in as many words. Register the callback
# http://localhost:3000/api/auth/google/callback on the Cloud OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Any 32+ characters on a laptop. A deployment mints a real one.
AUTH_SECRET="dev-secret-at-least-thirty-two-characters"
AUTH_URL="http://localhost:3000"

# The first sign-in against an empty database opens the account and takes super
# admin, so there is nothing to seed and nobody to invite.
#
# Both of these are empty here on purpose. GOOGLE_HOSTED_DOMAIN locks sign-in to
# one Google Workspace domain; RAWR_VISITOR_ACCOUNT gives everybody else a
# read-only seat in the account named. Empty means neither rule applies and a
# stranger is told to ask for an invitation.
GOOGLE_HOSTED_DOMAIN=""
RAWR_VISITOR_ACCOUNT=""


# --- Stand-ins --------------------------------------------------------------
# Calendars, Gmail and the provider integrations, faked locally, so booking,
# mailbox sync and the integration framework are exercisable without a Google
# project or a paid plan anywhere. Every one of them refuses to work when
# NODE_ENV is production, whatever it is set to.
RAWR_DEV_CALENDAR="1"
RAWR_DEV_GMAIL="1"
RAWR_DEV_INTEGRATIONS="1"


# --- The worker -------------------------------------------------------------
# Six job families ask the app to do the work and prove they are the worker with
# this. The same value on both, or the worker boots clean and quietly dead-
# letters every one of them.
RAWR_INTERNAL_SECRET="dev-internal-secret-not-for-production"
RAWR_INTERNAL_URL="http://localhost:3000"


# --- Optional ---------------------------------------------------------------
# 32 bytes. Without it the calendar and mailbox tokens cannot be encrypted, so
# connecting either says so rather than half working:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Any S3-compatible store, for attachments. Absent means the Files panel says it
# is not connected. Keep the bucket private: every read is a signed link.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="attachments"
S3_REGION="us-east-1"

# Everything below has a working default and is here to be found, not set.
#
# RAWR_CALENDAR_AT_SIGNIN  1 asks for the calendar during sign-in. Off, because
#                          those scopes are restricted and an OAuth client
#                          Google has not reviewed can have the whole
#                          authorisation refused over them.
# EDGE_IP_SALT             visitor IPs are hashed with it, never stored raw.
# CONSENT_POLICY_VERSION   bumping it re-prompts everyone whose stored choice
#                          predates the change.
# PUBLIC_BASE_URL          where the public edge is reachable from outside.
#                          Falls back to AUTH_URL, which is right on a laptop.
# TRUSTED_PROXY_HOPS       how many proxies sit in front. 1 unless you know.
# DATABASE_POOL_MAX        lower it to 5 when running the suites beside the dev
#                          server, or the two together exhaust the connection
#                          limit and the failures read as logic errors.
