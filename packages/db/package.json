{
  "name": "@rawr/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./forms": "./src/dal/form-schema.ts",
    "./templates": "./src/dal/templates.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file=../../.env.local scripts/migrate.ts",
    "seed": "node --env-file=../../.env.local scripts/seed.ts",
    "verify": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-tenancy.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=postgres://unit:test@127.0.0.1:5432/none DATABASE_URL_OWNER=postgres://unit:test@127.0.0.1:5432/none node --test \"src/**/*.test.ts\"",
    "verify:guards": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-guards.ts",
    "verify:crm": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-crm.ts",
    "verify:forms": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-forms.ts",
    "verify:booking": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-booking.ts",
    "verify:mcp": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-mcp.ts",
    "verify:activity": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-activity.ts",
    "verify:admin": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-admin.ts",
    "verify:integrations": "DATABASE_POOL_MAX=2 node --env-file=../../.env.local scripts/verify-integrations.ts",
    "verify:org": "node --env-file=../../.env.local scripts/verify-org.ts",
    "verify:mail": "node --env-file=../../.env.local scripts/verify-mail.ts",
    "verify:sequences": "node --env-file=../../.env.local scripts/verify-sequences.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "psl": "^1.15.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
