{
  "name": "rawr",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @rawr/web dev",
    "worker": "pnpm --filter @rawr/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @rawr/db generate",
    "db:migrate": "pnpm --filter @rawr/db migrate",
    "db:seed": "pnpm --filter @rawr/db seed",
    "db:verify": "pnpm --filter @rawr/db verify",
    "db:verify:sql": "pnpm --filter @rawr/db verify:sql",
    "db:verify:guards": "pnpm --filter @rawr/db verify:guards",
    "lint": "biome lint .",
    "lint:ci": "biome ci . --diagnostic-level=error && node apps/web/scripts/check-client-imports.ts",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm -r typecheck && pnpm lint:ci && pnpm test && pnpm db:verify:sql && pnpm db:verify && pnpm db:verify:guards && pnpm db:verify:account && pnpm db:verify:crm && pnpm db:verify:automations && pnpm db:verify:imports && pnpm db:verify:admin && pnpm db:verify:forms && pnpm db:verify:booking && pnpm db:verify:mcp && pnpm db:verify:activity && pnpm db:verify:mail && pnpm db:verify:sequences && pnpm db:verify:integrations && pnpm db:verify:reporting && pnpm db:verify:objects && pnpm db:verify:notifications && pnpm db:verify:preferences",
    "db:verify:crm": "pnpm --filter @rawr/db verify:crm",
    "db:verify:automations": "pnpm --filter @rawr/db verify:automations",
    "db:verify:imports": "pnpm --filter @rawr/db verify:imports",
    "db:verify:forms": "pnpm --filter @rawr/db verify:forms",
    "db:verify:booking": "pnpm --filter @rawr/db verify:booking",
    "db:verify:mcp": "pnpm --filter @rawr/db verify:mcp",
    "db:verify:activity": "pnpm --filter @rawr/db verify:activity",
    "db:verify:admin": "pnpm --filter @rawr/db verify:admin",
    "db:verify:integrations": "pnpm --filter @rawr/db verify:integrations",
    "db:verify:account": "pnpm --filter @rawr/db verify:account",
    "db:verify:mail": "pnpm --filter @rawr/db verify:mail",
    "db:verify:sequences": "pnpm --filter @rawr/db verify:sequences",
    "db:verify:reporting": "pnpm --filter @rawr/db verify:reporting",
    "db:verify:scale": "pnpm --filter @rawr/db verify:scale",
    "db:reclaim": "pnpm --filter @rawr/db reclaim",
    "db:probe:large": "pnpm --filter @rawr/db probe:large",
    "db:verify:objects": "pnpm --filter @rawr/db verify:objects",
    "db:verify:notifications": "pnpm --filter @rawr/db verify:notifications",
    "db:verify:preferences": "pnpm --filter @rawr/db verify:preferences"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "catalog:"
  }
}
